подключить ядро.ос
подключить ядро.фс
подключить ядро.текст
подключить ядро.консоль
подключить json

переч ОшибкаПроверки
{
    Использование
    Ввод(ос.ОшибкаВвода)
    Разбор(json.ОшибкаРазбора)
}

функ вход() -> Итог(пусто, ОшибкаПроверки)
{
    аргументы = ос.аргументы()
    если аргументы.длина != 2
    {
        попытка консоль.ошибка("использование: проверить-json <файл>")
        возврат Ошибка(Использование)
    }
    регион
    {
        документ = попытка фс.прочитатьТекст(аргументы[1])
        выбор json.разобрать(документ)
        {
            Успех(значение) =>
            {
                всего = количествоЗначений(&значение)
                попытка консоль.печать(текст.формат("корректный JSON, значений: {}", всего))
            }
            Ошибка(сбой)    =>
            {
                попытка консоль.ошибка(сбой.описать(документ))
                возврат Ошибка(Разбор(сбой))
            }
        }
    }
    возврат Успех()
}

функ количествоЗначений(значение: &json.Значение) -> разм
{
    изм всего: разм = 1
    если значение это Список(элементы)
    {
        цикл элемент в элементы
        {
            всего += количествоЗначений(элемент)
        }
    }
    если значение это Объект(поля)
    {
        цикл поле в поля
        {
            всего += количествоЗначений(&поле.значение)
        }
    }
    возврат всего
}
