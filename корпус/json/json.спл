откр функ разобрать(документ: стр) требует Регион -> Итог(Значение, ОшибкаРазбора)
{
    изм разборщик = Разборщик{ документ, байты: документ.байты(), позиция: 0, глубина: 0 }
    значение = попытка разборщик.значение()
    разборщик.пропуститьПробелы()
    если разборщик.позиция != разборщик.байты.длина
    {
        возврат Ошибка(ЛишниеДанные(разборщик.позиция))
    }
    возврат Успех(значение)
}

