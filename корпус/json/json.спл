}

откр функ ОшибкаРазбора.описать(&сам, документ: стр) требует Регион -> стр
{
    возврат выбор сам
    {
        НеожиданныйБайт(смещение) => сМестом(документ, смещение, "неожиданный символ")
        НеожиданныйКонец          => "документ оборвался"
        НеверныйЭкран(смещение)   => сМестом(документ, смещение, "неверное экранирование")
        НеверноеЧисло(смещение)   => сМестом(документ, смещение, "неверное число")
        СлишкомГлубоко(смещение)  => сМестом(документ, смещение, "слишком глубокая вложенность")
        ЛишниеДанные(смещение)    => сМестом(документ, смещение, "лишние данные после значения")
    }
}

откр функ позицияВДокументе(документ: стр, смещение: разм) -> Позиция
{
    изм строка: разм = 1
    изм началоСтроки: разм = 0
    цикл (индекс, байт) в документ.байты()[..смещение].перечислить()
    {
        если байт == б'\n'
        {
            строка += 1
            началоСтроки = индекс + 1
        }
    }
    графем = документ.срез(началоСтроки..смещение).графемы().количество()
    возврат Позиция{ строка, столбец: графем + 1 }
}

функ сМестом(документ: стр, смещение: разм, суть: стр) требует Регион -> стр
{
    место = позицияВДокументе(документ, смещение)
    возврат текст.формат("{}:{}: {}", место.строка, место.столбец, суть)
}

функ Разборщик.значение(&изм сам) требует Регион -> Итог(Значение, ОшибкаРазбора)
{
    сам.пропуститьПробелы()
    если сам.позиция == сам.байты.длина
    {
        возврат Ошибка(НеожиданныйКонец)
    }
    возврат выбор сам.байты[сам.позиция]
    {
        б'{'                 => сам.объект()
        б'['                 => сам.список()
        б'"'                 => Успех(Текст(попытка сам.строка()))
        б't'                 => сам.слово("true", Логическое(да))
        б'f'                 => сам.слово("false", Логическое(нет))
        б'n'                 => сам.слово("null", Нуль)
        б'-' или б'0'..=б'9' => сам.число()
        _                    => Ошибка(НеожиданныйБайт(сам.позиция))
    }
}

функ Разборщик.объект(&изм сам) требует Регион -> Итог(Значение, ОшибкаРазбора)
{
    попытка сам.войти()
    отложить сам.выйти()
    сам.позиция += 1
    изм поля = Массив(Поле).новый()
    сам.пропуститьПробелы()
    если не сам.принять(б'}')
    {
        цикл
        {
            сам.пропуститьПробелы()
            ключ = попытка сам.строка()
            сам.пропуститьПробелы()
            попытка сам.ожидать(б':')
            поля.добавить(Поле{ ключ, значение: попытка сам.значение() })
            сам.пропуститьПробелы()
            если сам.принять(б'}')
            {
                прервать
            }
            попытка сам.ожидать(б',')
        }
    }
    возврат Успех(Объект(поля))
}

функ Разборщик.список(&изм сам) требует Регион -> Итог(Значение, ОшибкаРазбора)
{
    попытка сам.войти()
    отложить сам.выйти()
    сам.позиция += 1
    изм элементы = Массив(Значение).новый()
    сам.пропуститьПробелы()
    если не сам.принять(б']')
    {
        цикл
        {
            элементы.добавить(попытка сам.значение())
            сам.пропуститьПробелы()
            если сам.принять(б']')
            {
                прервать
            }
            попытка сам.ожидать(б',')
        }
    }
    возврат Успех(Список(элементы))
}

функ Разборщик.строка(&изм сам) требует Регион -> Итог(стр, ОшибкаРазбора)
{
    попытка сам.ожидать(б'"')
    начало = сам.позиция
    цикл сам.позиция < сам.байты.длина
    {
        выбор сам.байты[сам.позиция]
        {
            б'"'        =>
            {
                фрагмент = сам.документ.срез(начало..сам.позиция)
                сам.позиция += 1
                возврат Успех(фрагмент)
            }
            б'\\'       => возврат сам.строкаСЭкранами(начало)
            0x00..=0x1F => возврат Ошибка(НеожиданныйБайт(сам.позиция))
            _           => сам.позиция += 1
        }
    }
    возврат Ошибка(НеожиданныйКонец)
}

функ Разборщик.строкаСЭкранами(&изм сам, начало: разм) требует Регион -> Итог(стр, ОшибкаРазбора)
{
    изм построитель = текст.Построитель.новый()
    построитель.добавить(сам.документ.срез(начало..сам.позиция))
    цикл сам.позиция < сам.байты.длина
    {
        байт = сам.байты[сам.позиция]
        если байт == б'"'
        {
            сам.позиция += 1
            возврат Успех(построитель.готово())
        }
        если байт == б'\\'
        {
            построитель.добавитьСимвол(попытка сам.экран())
            продолжить
        }
        если байт < 0x20
        {
            возврат Ошибка(НеожиданныйБайт(сам.позиция))
        }
        началоКуска = сам.позиция
        цикл сам.позиция < сам.байты.длина и обычный(сам.байты[сам.позиция])
        {
            сам.позиция += 1
        }
        построитель.добавить(сам.документ.срез(началоКуска..сам.позиция))
    }
    возврат Ошибка(НеожиданныйКонец)
}

функ Разборщик.экран(&изм сам) -> Итог(сим, ОшибкаРазбора)
{
    начало = сам.позиция
    сам.позиция += 1
    если сам.позиция == сам.байты.длина
    {
        возврат Ошибка(НеожиданныйКонец)
    }
    вид = сам.байты[сам.позиция]
    сам.позиция += 1
    возврат выбор вид
    {
        б'"'  => Успех('"')
        б'\\' => Успех('\\')
        б'/'  => Успех('/')
        б'b'  => Успех('\u{8}')
        б'f'  => Успех('\u{C}')
        б'n'  => Успех('\n')
        б'r'  => Успех('\r')
        б't'  => Успех('\t')
        б'u'  => сам.кодUtf16(начало)
        _     => Ошибка(НеверныйЭкран(начало))
    }
}

функ Разборщик.кодUtf16(&изм сам, начало: разм) -> Итог(сим, ОшибкаРазбора)
{
    старший = попытка сам.четыреЦифры16(начало)
    если старший в 0xDC00..=0xDFFF
    {
        возврат Ошибка(НеверныйЭкран(начало))
    }
    если старший не в 0xD800..=0xDBFF
    {
        возврат символИзКода(старший, начало)
    }
    если не (сам.принять(б'\\') и сам.принять(б'u'))
    {
        возврат Ошибка(НеверныйЭкран(начало))
    }
    младший = попытка сам.четыреЦифры16(начало)
    если младший не в 0xDC00..=0xDFFF
    {
        возврат Ошибка(НеверныйЭкран(начало))
    }
    код = 0x10000 + ((старший - 0xD800) << 10) + (младший - 0xDC00)
    возврат символИзКода(код, начало)
}

функ Разборщик.четыреЦифры16(&изм сам, начало: разм) -> Итог(н32, ОшибкаРазбора)
{
    изм код: н32 = 0
    цикл _ в 0..4
    {
        если сам.позиция == сам.байты.длина
        {
            возврат Ошибка(НеожиданныйКонец)
        }
        байт = сам.байты[сам.позиция]
        цифра = выбор байт
        {
            б'0'..=б'9' => байт - б'0'
            б'a'..=б'f' => байт - б'a' + 10
            б'A'..=б'F' => байт - б'A' + 10
            _           => возврат Ошибка(НеверныйЭкран(начало))
        }
        код = код * 16 + цифра как н32
        сам.позиция += 1
    }
    возврат Успех(код)
}

функ Разборщик.число(&изм сам) -> Итог(Значение, ОшибкаРазбора)
{
    начало = сам.позиция
    _ = сам.принять(б'-')
    началоЦифр = сам.позиция
    цифрЦелой = сам.пропуститьЦифры()
    если цифрЦелой == 0 или (цифрЦелой > 1 и сам.байты[началоЦифр] == б'0')
    {
        возврат Ошибка(НеверноеЧисло(начало))
    }
    изм дробное = нет
    если сам.принять(б'.')
    {
        попытка сам.требоватьЦифры(начало)
        дробное = да
    }
    если сам.принять(б'e') или сам.принять(б'E')
    {
        _ = сам.принять(б'+') или сам.принять(б'-')
        попытка сам.требоватьЦифры(начало)
        дробное = да
    }
    запись = сам.документ.срез(начало..сам.позиция)
    если не дробное
    {
        если числа.разобратьЦ64(запись) это Есть(целое)
        {
            возврат Успех(Целое(целое))
        }
    }
    возврат выбор числа.разобратьВ64(запись)
    {
        Есть(вещественное) => Успех(Дробное(вещественное))
        Ничего             => Ошибка(НеверноеЧисло(начало))
    }
}

функ Разборщик.требоватьЦифры(&изм сам, начало: разм) -> Итог(пусто, ОшибкаРазбора)
{
    если сам.пропуститьЦифры() == 0
    {
        возврат Ошибка(НеверноеЧисло(начало))
    }
    возврат Успех()
}

функ Разборщик.пропуститьЦифры(&изм сам) -> разм
{
    начало = сам.позиция
    цикл сам.позиция < сам.байты.длина и (сам.байты[сам.позиция] в б'0'..=б'9')
    {
        сам.позиция += 1
    }
    возврат сам.позиция - начало
}

функ Разборщик.слово(&изм сам, литерал: стр, значение: Значение) -> Итог(Значение, ОшибкаРазбора)
{
    конец = сам.позиция + литерал.байты().длина
    если конец > сам.байты.длина
    {
        возврат Ошибка(НеожиданныйКонец)
    }
    если сам.байты[сам.позиция..конец] != литерал.байты()
    {
        возврат Ошибка(НеожиданныйБайт(сам.позиция))
    }
    сам.позиция = конец
    возврат Успех(значение)
}

функ Разборщик.принять(&изм сам, байт: н8) -> бул
{
    если сам.позиция < сам.байты.длина и сам.байты[сам.позиция] == байт
    {
        сам.позиция += 1
        возврат да
    }
    возврат нет
}

функ Разборщик.ожидать(&изм сам, байт: н8) -> Итог(пусто, ОшибкаРазбора)
{
    если сам.принять(байт)
    {
        возврат Успех()
    }
    если сам.позиция == сам.байты.длина
    {
        возврат Ошибка(НеожиданныйКонец)
    }
    возврат Ошибка(НеожиданныйБайт(сам.позиция))
}

функ Разборщик.пропуститьПробелы(&изм сам)
{
    цикл сам.позиция < сам.байты.длина и пробельный(сам.байты[сам.позиция])
    {
        сам.позиция += 1
    }
}

функ Разборщик.войти(&изм сам) -> Итог(пусто, ОшибкаРазбора)
{
    если сам.глубина == МАКС_ГЛУБИНА
    {
        возврат Ошибка(СлишкомГлубоко(сам.позиция))
    }
    сам.глубина += 1
    возврат Успех()
}

функ Разборщик.выйти(&изм сам)
{
    сам.глубина -= 1
}

функ пробельный(байт: н8) -> бул
{
    возврат байт это (б' ' или б'\t' или б'\n' или б'\r')
}

функ обычный(байт: н8) -> бул
{
    возврат байт != б'"' и байт != б'\\' и байт >= 0x20
}

функ символИзКода(код: н32, начало: разм) -> Итог(сим, ОшибкаРазбора)
{
    возврат выбор сим.изКода(код)
    {
        Есть(символ) => Успех(символ)
        Ничего       => Ошибка(НеверныйЭкран(начало))
    }
}

функ записатьЗначение(выход: &изм текст.Построитель, значение: &Значение)
{
    выбор значение
    {
        Нуль                                 => выход.добавить("null")
        Логическое(да)                       => выход.добавить("true")
        Логическое(нет)                      => выход.добавить("false")
        Целое(число)                         => числа.записатьЦ64(выход, число)
        Дробное(число) если число.конечное() => числа.записатьВ64(выход, число)
        Дробное(_)                           => выход.добавить("null")
        Текст(содержимое)                    => записатьСтроку(выход, содержимое)
        Список(элементы)                     => записатьСписок(выход, &элементы)
        Объект(поля)                         => записатьОбъект(выход, &поля)
    }
}

функ записатьСписок(выход: &изм текст.Построитель, элементы: &Массив(Значение))
{
    выход.добавитьСимвол('[')
    цикл (номер, элемент) в элементы.перечислить()
    {
        если номер > 0
        {
            выход.добавитьСимвол(',')
        }
        записатьЗначение(выход, элемент)
    }
    выход.добавитьСимвол(']')
}

функ записатьОбъект(выход: &изм текст.Построитель, поля: &Массив(Поле))
{
    выход.добавитьСимвол('{')
    цикл (номер, поле) в поля.перечислить()
    {
        если номер > 0
        {
            выход.добавитьСимвол(',')
        }
        записатьСтроку(выход, поле.ключ)
        выход.добавитьСимвол(':')
        записатьЗначение(выход, &поле.значение)
    }
    выход.добавитьСимвол('}')
}

функ записатьСтроку(выход: &изм текст.Построитель, содержимое: стр)
{
    выход.добавитьСимвол('"')
    цикл символ в содержимое.символы()
    {
        выбор символ
        {
            '"'                => выход.добавить("\\\"")
            '\\'               => выход.добавить("\\\\")
            '\n'               => выход.добавить("\\n")
            '\r'               => выход.добавить("\\r")
            '\t'               => выход.добавить("\\t")
            '\u{0}'..='\u{1F}' => записатьКод(выход, символ)
            _                  => выход.добавитьСимвол(символ)
        }
    }
    выход.добавитьСимвол('"')
}

функ записатьКод(выход: &изм текст.Построитель, символ: сим)
{
    код = символ как н32
    выход.добавить("\\u00")
    выход.добавитьСимвол(ЦИФРЫ_16[(код >> 4) как разм])
    выход.добавитьСимвол(ЦИФРЫ_16[(код & 0xF) как разм])
}

