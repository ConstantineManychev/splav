откр конст Век3 = Вектор(в32, 3)
откр конст ИтогВычисления = Итог(пусто, вычислитель.ОшибкаВычислителя)

конст ДИАМЕТР: в32 = 1.0
конст ЗАЗОР_РЕШЁТКИ: в32 = 1.05
конст ЖЁСТКОСТЬ: в32 = 1000.0
конст ТЯЖЕСТЬ: в32 = 1.0
конст ШАГ_ВРЕМЕНИ: в32 = 0.002
конст НАЧАЛЬНАЯ_СКОРОСТЬ: в32 = 0.1
конст СОСЕДНИХ_ЯЧЕЕК = 27
конст FNV_НАЧАЛО: н64 = 0xCBF29CE484222325
конст FNV_МНОЖИТЕЛЬ: н64 = 0x100000001B3

[Тест]
конст СТОРОНА_СРАВНЕНИЯ: н32 = 32

[Тест]
конст МАЛАЯ_СТОРОНА: н32 = 8

[Тест]
конст ШАГОВ_СРАВНЕНИЯ: разм = 200

[Тест]
конст ШАГОВ_ЭНЕРГИИ: разм = 2000

[Тест]
конст ДОПУСК_ЭНЕРГИИ: в64 = 0.001

откр набор Частица
{
    откр позиция: Век3
    откр скорость: Век3
    откр ид: н32
}

откр структ Мир
{
    размер: в32
    ячеекПоСтороне: н32
    размерЯчейки: в32
    диаметр: в32
    жёсткость: в32
    тяжесть: в32
    шаг: в32
    частицНаСторону: н32
    шагРешётки: в32
    начальнаяСкорость: в32
}

структ Клетка
{
    х: ц32
    у: ц32
    з: ц32
}

откр структ Состояние
{
    мир: Мир
    откр частицы: вычислитель.Буфер(Частица)
    упорядоченные: вычислитель.Буфер(Частица)
    ключи: вычислитель.Буфер(н32)
    порядок: вычислитель.Буфер(н32)
    начала: вычислитель.Буфер(н32)
}

откр функ мирДля(частицНаСторону: н32) -> Мир
{
    шагРешётки = ДИАМЕТР * ЗАЗОР_РЕШЁТКИ
    размер = 2.0 * частицНаСторону как в32 * шагРешётки
    ячеекПоСтороне = (размер / ДИАМЕТР) как н32
    возврат Мир{
        размер,
        ячеекПоСтороне,
        размерЯчейки: размер / ячеекПоСтороне как в32,
        диаметр: ДИАМЕТР,
        жёсткость: ЖЁСТКОСТЬ,
        тяжесть: ТЯЖЕСТЬ,
        шаг: ШАГ_ВРЕМЕНИ,
        частицНаСторону,
        шагРешётки,
        начальнаяСкорость: НАЧАЛЬНАЯ_СКОРОСТЬ,
    }
}

откр функ Мир.количество(&сам) -> разм
{
    сторона = сам.частицНаСторону как разм
    возврат сторона * сторона * сторона
}

откр функ Мир.ячеек(&сам) -> разм
{
    сторона = сам.ячеекПоСтороне как разм
    возврат сторона * сторона * сторона
}

откр функ Состояние.новое(мир: Мир) -> Состояние
{
    количество = мир.количество()
    возврат Состояние{
        мир,
        частицы: вычислитель.Буфер(Частица).новый(количество),
        упорядоченные: вычислитель.Буфер(Частица).новый(количество),
        ключи: вычислитель.Буфер(н32).новый(количество),
        порядок: вычислитель.Буфер(н32).новый(количество),
        начала: вычислитель.Буфер(н32).новый(мир.ячеек() + 1),
    }
}

откр функ Состояние.освободить(сам)
{
    Состояние{ мир: _, частицы, упорядоченные, ключи, порядок, начала } = сам
    частицы.освободить()
    упорядоченные.освободить()
    ключи.освободить()
    порядок.освободить()
    начала.освободить()
}

откр функ Состояние.начать(&изм сам, исполнитель: &вычислитель.Исполнитель) -> ИтогВычисления
{
    возврат исполнитель.заполнить(&изм сам.частицы, начальнаяЧастица, сам.мир)
}

откр функ Состояние.прогнать(
    &изм сам,
    исполнитель: &вычислитель.Исполнитель,
    шагов: разм,
) -> ИтогВычисления
{
    цикл _ в 0..шагов
    {
        попытка сам.шаг(исполнитель)
    }
    возврат Успех()
}

откр функ Состояние.шаг(&изм сам, исполнитель: &вычислитель.Исполнитель) -> ИтогВычисления
{
    попытка исполнитель.заполнить(&изм сам.ключи, ключЯчейки, &сам.частицы, сам.мир)
    попытка исполнитель.разложить(&изм сам.порядок, &изм сам.начала, &сам.ключи)
    попытка исполнитель.заполнить(&изм сам.упорядоченные, собрать, &сам.порядок, &сам.частицы)
    попытка исполнитель.заполнить(
        &изм сам.частицы,
        обновитьЧастицу,
        &сам.упорядоченные,
        &сам.начала,
        сам.мир,
    )
    возврат Успех()
}

[Гибрид]
функ начальнаяЧастица(номер: разм, мир: Мир) -> Частица
{
    сторона = мир.частицНаСторону как разм
    узел = Век3{
        (номер % сторона) как в32,
        (номер / сторона % сторона) как в32,
        (номер / (сторона * сторона)) как в32,
    }
    позиция = (узел + Век3{ 0.5, 0.5, 0.5 }) * мир.шагРешётки
    скорость = Век3{ шум(номер, 0), шум(номер, 1), шум(номер, 2) } * мир.начальнаяСкорость
    возврат Частица{ позиция, скорость, ид: номер как н32 }
}

[Гибрид]
функ шум(номер: разм, ось: н32) -> в32
{
    изм х = номер как н32 *% 3 +% ось
    х бит_искл= х >> 16
    х = х *% 0x7FEB352D
    х бит_искл= х >> 15
    х = х *% 0x846CA68B
    х бит_искл= х >> 16
    возврат (х >> 8) как в32 * (2.0 / 16777216.0) - 1.0
}

[Гибрид]
функ ключЯчейки(номер: разм, частицы: []Частица, мир: Мир) -> н32
{
    возврат номерЯчейки(клетка(частицы[номер].позиция, мир), мир)
}

[Гибрид]
функ собрать(номер: разм, порядок: []н32, частицы: []Частица) -> Частица
{
    возврат частицы[порядок[номер] как разм]
}

[Гибрид]
функ обновитьЧастицу(номер: разм, частицы: []Частица, начала: []н32, мир: Мир) -> Частица
{
    частица = частицы[номер]
    своя = клетка(частица.позиция, мир)
    изм ускорение = внешнееУскорение(частица.позиция, мир)
    цикл сосед в 0..СОСЕДНИХ_ЯЧЕЕК
    {
        соседняя = Клетка{
            х: своя.х + (сосед % 3) как ц32 - 1,
            у: своя.у + (сосед / 3 % 3) как ц32 - 1,
            з: своя.з + (сосед / 9) как ц32 - 1,
        }
        если внутри(соседняя, мир)
        {
            ячейка = номерЯчейки(соседняя, мир) как разм
            цикл другой в начала[ячейка] как разм..начала[ячейка + 1] как разм
            {
                если другой != номер
                {
                    ускорение += упругость(частица.позиция, частицы[другой].позиция, мир)
                }
            }
        }
    }
    возврат сдвинуть(частица, ускорение, мир)
}

[Гибрид]
функ сдвинуть(частица: Частица, ускорение: Век3, мир: Мир) -> Частица
{
    скорость = частица.скорость + ускорение * мир.шаг
    позиция = частица.позиция + скорость * мир.шаг
    возврат Частица{ позиция, скорость, ид: частица.ид }
}

[Гибрид]
функ внешнееУскорение(позиция: Век3, мир: Мир) -> Век3
{
    возврат упругостьСтен(позиция, мир) - Век3{ 0.0, 0.0, мир.тяжесть }
}

[Гибрид]
функ упругость(своя: Век3, чужая: Век3, мир: Мир) -> Век3
{
    разность = своя - чужая
    квадрат = скалярное(разность, разность)
    если квадрат >= мир.диаметр * мир.диаметр или квадрат == 0.0
    {
        возврат Век3{ 0.0, 0.0, 0.0 }
    }
    расстояние = математика.корень(квадрат)
    возврат разность * (мир.жёсткость * (мир.диаметр - расстояние) / расстояние)
}

[Гибрид]
функ упругостьСтен(позиция: Век3, мир: Мир) -> Век3
{
    возврат Век3{ стена(позиция.х, мир), стена(позиция.у, мир), стена(позиция.з, мир) }
}

[Гибрид]
функ стена(координата: в32, мир: Мир) -> в32
{
    радиус = мир.диаметр * 0.5
    если координата < радиус
    {
        возврат мир.жёсткость * (радиус - координата)
    }
    верх = мир.размер - радиус
    если координата > верх
    {
        возврат мир.жёсткость * (верх - координата)
    }
    возврат 0.0
}

[Гибрид]
функ скалярное(а: Век3, б: Век3) -> в32
{
    возврат а.х * б.х + а.у * б.у + а.з * б.з
}

[Гибрид]
функ клетка(позиция: Век3, мир: Мир) -> Клетка
{
    возврат Клетка{
        х: координатаКлетки(позиция.х, мир),
        у: координатаКлетки(позиция.у, мир),
        з: координатаКлетки(позиция.з, мир),
    }
}

[Гибрид]
функ координатаКлетки(координата: в32, мир: Мир) -> ц32
{
    сырая = математика.пол(координата / мир.размерЯчейки) как ц32
    возврат математика.ограничить(сырая, 0, мир.ячеекПоСтороне как ц32 - 1)
}

[Гибрид]
функ номерЯчейки(клетка: Клетка, мир: Мир) -> н32
{
    сторона = мир.ячеекПоСтороне как ц32
    возврат ((клетка.з * сторона + клетка.у) * сторона + клетка.х) как н32
}

[Гибрид]
функ внутри(клетка: Клетка, мир: Мир) -> бул
{
    сторона = мир.ячеекПоСтороне как ц32
    возврат клетка.х в 0..сторона и клетка.у в 0..сторона и клетка.з в 0..сторона
}

откр функ энергия(частицы: []Частица, мир: Мир) -> в64
{
    изм сумма: в64 = 0.0
    цикл (номер, частица) в частицы.перечислить()
    {
        скорость = частица.скорость
        сумма += 0.5 * скалярное(скорость, скорость) как в64
        сумма += мир.тяжесть как в64 * частица.позиция.з как в64
        сумма += энергияСтен(частица.позиция, мир)
        цикл другой в номер + 1..частицы.длина
        {
            сумма += энергияПары(частица.позиция, частицы[другой].позиция, мир)
        }
    }
    возврат сумма
}

функ энергияПары(своя: Век3, чужая: Век3, мир: Мир) -> в64
{
    разность = своя - чужая
    расстояние = математика.корень(скалярное(разность, разность) как в64)
    перекрытие = мир.диаметр как в64 - расстояние
    если перекрытие <= 0.0
    {
        возврат 0.0
    }
    возврат 0.5 * мир.жёсткость как в64 * перекрытие * перекрытие
}

функ энергияСтен(позиция: Век3, мир: Мир) -> в64
{
    поХ = энергияСтены(позиция.х, мир)
    поУ = энергияСтены(позиция.у, мир)
    поЗ = энергияСтены(позиция.з, мир)
    возврат поХ + поУ + поЗ
}

функ энергияСтены(координата: в32, мир: Мир) -> в64
{
    сила = стена(координата, мир) как в64
    возврат 0.5 * сила * сила / мир.жёсткость как в64
}

откр функ отпечаток(частицы: []Частица) -> н64
{
    изм хеш = FNV_НАЧАЛО
    цикл частица в частицы
    {
        хеш = смешать(хеш, частица.позиция.х.биты())
        хеш = смешать(хеш, частица.позиция.у.биты())
        хеш = смешать(хеш, частица.позиция.з.биты())
        хеш = смешать(хеш, частица.скорость.х.биты())
        хеш = смешать(хеш, частица.скорость.у.биты())
        хеш = смешать(хеш, частица.скорость.з.биты())
        хеш = смешать(хеш, частица.ид)
    }
    возврат хеш
}

функ смешать(хеш: н64, слово: н32) -> н64
{
    возврат (хеш бит_искл слово как н64) *% FNV_МНОЖИТЕЛЬ
}

