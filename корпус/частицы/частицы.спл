[Гибрид]
функ обновитьПеребором(номер: разм, частицы: []Частица, мир: Мир) -> Частица
{
    частица = частицы[номер]
    изм ускорение = внешнееУскорение(частица.позиция, мир)
    цикл другой в 0..частицы.длина
    {
        если другой != номер
        {
            ускорение += упругость(частица.позиция, частицы[другой].позиция, мир)
        }
    }
    возврат сдвинуть(частица, ускорение, мир)
}

[Тест]
функ цпуИГпуСовпадаютПобитно() -> Итог(пусто, тест.Провал)
{
    гпу = выбор вычислитель.гпу()
    {
        Успех(исполнитель) => исполнитель
        Ошибка(_)          => возврат Ошибка(тест.пропуск("нет ГПУ со строгой арифметикой"))
    }
    попытка сравнитьИсполнителей(&вычислитель.цпу(), &гпу)
    возврат Успех()
}

[Тест]
функ потокиНеМеняютРезультат() -> Итог(пусто, тест.Провал)
{
    попытка сравнитьИсполнителей(&вычислитель.цпуПотоков(1), &вычислитель.цпу())
    возврат Успех()
}

[Тест]
функ сравнитьИсполнителей(
    первый: &вычислитель.Исполнитель,
    второй: &вычислитель.Исполнитель,
) -> Итог(пусто, тест.Провал)
{
    мир = мирДля(СТОРОНА_СРАВНЕНИЯ)
    изм а = Состояние.новое(мир)
    отложить а.освободить()
    изм б = Состояние.новое(мир)
    отложить б.освободить()
    попытка тест.ожидатьУспех(а.начать(первый))
    попытка тест.ожидатьУспех(а.прогнать(первый, ШАГОВ_СРАВНЕНИЯ))
    попытка тест.ожидатьУспех(б.начать(второй))
    попытка тест.ожидатьУспех(б.прогнать(второй, ШАГОВ_СРАВНЕНИЯ))
    частицыА = попытка тест.ожидатьУспех(а.частицы.наХосте())
    частицыБ = попытка тест.ожидатьУспех(б.частицы.наХосте())
    возврат тест.ожидатьПобитно(частицыА, частицыБ)
}

[Тест]
функ переборСовпадаетСЯчейками() -> Итог(пусто, тест.Провал)
{
    исполнитель = вычислитель.цпу()
    мир = мирДля(МАЛАЯ_СТОРОНА)
    изм состояние = Состояние.новое(мир)
    отложить состояние.освободить()
    изм перебором = вычислитель.Буфер(Частица).новый(мир.количество())
    отложить перебором.освободить()
    попытка тест.ожидатьУспех(состояние.начать(&исполнитель))
    попытка тест.ожидатьУспех(состояние.прогнать(&исполнитель, ШАГОВ_СРАВНЕНИЯ))
    попытка тест.ожидатьУспех(состояние.шаг(&исполнитель))
    попытка тест.ожидатьУспех(исполнитель.заполнить(
        &изм перебором,
        обновитьПеребором,
        &состояние.упорядоченные,
        мир,
    ))
    ячейками = попытка тест.ожидатьУспех(состояние.частицы.наХосте())
    всеПары = попытка тест.ожидатьУспех(перебором.наХосте())
    возврат тест.ожидатьПобитно(ячейками, всеПары)
}

[Тест]
функ энергияСохраняется() -> Итог(пусто, тест.Провал)
{
    исполнитель = вычислитель.цпу()
    мир = мирДля(МАЛАЯ_СТОРОНА)
    изм состояние = Состояние.новое(мир)
    отложить состояние.освободить()
