подключить ядро.ос
подключить ядро.время
подключить ядро.текст
подключить ядро.журнал
подключить ядро.вычислитель
подключить частицы

конст ЧАСТИЦ_НА_СТОРОНУ: н32 = 100
конст ШАГОВ: разм = 200

переч ОшибкаЗапуска
{
    Использование
    Вычисление(вычислитель.ОшибкаВычислителя)
}

функ вход() -> Итог(пусто, ОшибкаЗапуска)
{
    итог = запустить(ос.аргументы())
    выбор итог
    {
        Успех()               => {}
        Ошибка(Использование) => журнал.ошибка("использование: частицы [авто | цпу | гпу]")
        Ошибка(сбой)          => журнал.ошибка(сбой)
    }
    возврат итог
}

функ запустить(аргументы: []стр) -> Итог(пусто, ОшибкаЗапуска)
{
    исполнитель = попытка исполнительИз(аргументы)
    мир = частицы.мирДля(ЧАСТИЦ_НА_СТОРОНУ)
    изм состояние = частицы.Состояние.новое(мир)
    отложить состояние.освободить()
    попытка состояние.начать(&исполнитель)
    начало = время.сейчас()
    попытка состояние.прогнать(&исполнитель, ШАГОВ)
    конечные = попытка состояние.частицы.наХосте()
    прошло = время.сейчас() - начало
    частицШагов = (мир.количество() * ШАГОВ) как в64
    регион
    {
        журнал.сообщить(текст.формат(
            "{}: {} частиц, {} шагов за {}, {} частиц-шагов в секунду, отпечаток {}",
            исполнитель.описание(),
            мир.количество(),
            ШАГОВ,
            прошло,
            частицШагов / прошло.секунды(),
            частицы.отпечаток(конечные),
        ))
    }
    возврат Успех()
}

функ исполнительИз(аргументы: []стр) -> Итог(вычислитель.Исполнитель, ОшибкаЗапуска)
{
    если аргументы.длина == 1
    {
        возврат Успех(вычислитель.авто())
    }
    если аргументы.длина != 2
    {
        возврат Ошибка(Использование)
    }
    возврат выбор аргументы[1]
    {
        "авто" => Успех(вычислитель.авто())
        "цпу"  => Успех(вычислитель.цпу())
        "гпу"  => Успех(попытка вычислитель.гпу())
        _      => Ошибка(Использование)
    }
}
