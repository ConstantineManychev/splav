вставка "stdio.h"
вставка "string.h" как строкиСи
вставка "errno.h" как ошибкиСи

подключить ядро.ос
подключить ядро.текст

[Линейный]
откр структ ФайлСи
{
    поток: *stdio.FILE
}

[Линейный]
откр структ Черновик
{
    откр файл: ФайлСи
    путь: стр
}

откр функ ФайлСи.открыть(путь: стр) -> Итог(ФайлСи, ос.ОшибкаВвода)
{
    возврат открытьСРежимом(путь, "rb")
}

откр функ ФайлСи.создать(путь: стр) -> Итог(ФайлСи, ос.ОшибкаВвода)
{
    возврат открытьСРежимом(путь, "wbx")
}

откр функ ФайлСи.временный() -> Итог(ФайлСи, ос.ОшибкаВвода)
{
    опасно
    {
        выбор stdio.tmpfile()
        {
            Есть(поток) => возврат Успех(ФайлСи{ поток })
            Ничего      => возврат Ошибка(ошибкаВвода(ошибкиСи.errno))
        }
    }
}

функ открытьСРежимом(путь: стр, режим: [:0]н8) -> Итог(ФайлСи, ос.ОшибкаВвода)
{
    регион
    {
        имя = текст.вСи(путь)
        опасно
        {
            выбор stdio.fopen(имя.указатель(), режим.указатель())
            {
                Есть(поток) => возврат Успех(ФайлСи{ поток })
                Ничего      => возврат Ошибка(ошибкаВвода(ошибкиСи.errno))
            }
        }
    }
}

откр функ ФайлСи.читать(&сам, буфер: []изм н8) -> Итог(разм, ос.ОшибкаВвода)
{
    опасно
    {
        прочитано = stdio.fread(буфер.указатель(), 1, буфер.длина, сам.поток)
        если прочитано < буфер.длина и stdio.ferror(сам.поток) != 0
        {
            возврат Ошибка(ошибкаВвода(ошибкиСи.errno))
        }
        возврат Успех(прочитано)
    }
}

откр функ ФайлСи.писатьВсё(&сам, данные: []н8) -> Итог(пусто, ос.ОшибкаВвода)
{
    опасно
    {
        записано = stdio.fwrite(данные.указатель(), 1, данные.длина, сам.поток)
        если записано != данные.длина
        {
            возврат Ошибка(ошибкаВвода(ошибкиСи.errno))
        }
    }
    возврат Успех()
}

откр функ ФайлСи.сбросить(&сам) -> Итог(пусто, ос.ОшибкаВвода)
{
    опасно
    {
        если stdio.fflush(сам.поток) != 0
        {
            возврат Ошибка(ошибкаВвода(ошибкиСи.errno))
        }
    }
    возврат Успех()
}

откр функ ФайлСи.перемотать(&сам)
{
    опасно stdio.rewind(сам.поток)
}

откр функ ФайлСи.закрыть(сам)
{
    ФайлСи{ поток } = сам
    _ = опасно stdio.fclose(поток)
}

откр функ Черновик.создать(путь: стр) -> Итог(Черновик, ос.ОшибкаВвода)
{
    файл = попытка ФайлСи.создать(путь)
    возврат Успех(Черновик{ файл, путь })
}

откр функ Черновик.сохранить(сам) -> Итог(пусто, ос.ОшибкаВвода)
{
    Черновик{ файл, путь } = сам
    итог = файл.сбросить()
    файл.закрыть()
    если итог это Ошибка(_)
    {
        удалить(путь)
    }
    возврат итог
}

откр функ Черновик.отменить(сам)
{
    Черновик{ файл, путь } = сам
    файл.закрыть()
    удалить(путь)
}

откр функ удалить(путь: стр)
{
    регион
    {
        имя = текст.вСи(путь)
        _ = опасно stdio.remove(имя.указатель())
    }
}

откр функ описание(код: ц32) требует Регион -> стр
{
    опасно
    {
        если строкиСи.strerror(код) это Есть(сообщение)
        {
            если стр.изUtf8(сообщение.доНуля()) это Успех(пояснение)
            {
                возврат текст.формат("{} (errno {})", пояснение, код)
            }
        }
    }
    возврат текст.формат("ошибка C, errno {}", код)
}

функ ошибкаВвода(код: ц32) -> ос.ОшибкаВвода
{
    если код == ошибкиСи.ENOENT
    {
        возврат НеНайдено
    }
    если код == ошибкиСи.EACCES или код == ошибкиСи.EPERM
    {
        возврат НетДоступа
    }
    если код == ошибкиСи.EEXIST
    {
        возврат УжеЕсть
    }
    если код == ошибкиСи.ENOSPC
    {
        возврат НетМеста
    }
    возврат Система(код)
}
