подключить ядро.ос
подключить ядро.текст
подключить ядро.консоль
подключить поток

конст ВЕРСИЯ = "0.1.0"
конст СУФФИКС = ".gz"
конст СПРАВКА = "использование: сжать [-1 … -9] [-d | -t | -l] [-V] файл…"

переч Действие
{
    Сжать
    Разжать
    Проверить
    Перечислить
}

структ Настройки
{
    действие: Действие
    уровень: ц32
    версия: бул
}

переч ОшибкаЗапуска
{
    Использование
    НеВсеФайлы(неудач: разм)
    Вывод(ос.ОшибкаВвода)
}

переч ОшибкаФайла
{
    Сжатие(поток.ОшибкаСжатия)
    НетСуффикса
    Вывод(ос.ОшибкаВвода)
}

функ вход() -> Итог(пусто, ОшибкаЗапуска)
{
    аргументы = ос.аргументы()
    настройки = попытка разобратьНастройки(аргументы)
    если настройки.версия
    {
        регион
        {
            попытка консоль.печать("сжать ", ВЕРСИЯ, ", zlib ", поток.версияБиблиотеки(), " (заголовки ", поток.версияЗаголовков(), ")")
        }
        возврат Успех()
    }
    изм файлов: разм = 0
    изм неудач: разм = 0
    цикл аргумент в аргументы[1..]
    {
        если этоКлюч(аргумент)
        {
            продолжить
        }
        файлов += 1
        регион
        {
            если обработать(аргумент, &настройки) это Ошибка(сбой)
            {
                неудач += 1
                попытка консоль.ошибка("сжать: ", аргумент, ": ", сбой.описать())
            }
        }
    }
    если файлов == 0
    {
        попытка консоль.ошибка(СПРАВКА)
        возврат Ошибка(Использование)
    }
    если неудач > 0
    {
        возврат Ошибка(НеВсеФайлы(неудач))
    }
    возврат Успех()
}

функ разобратьНастройки(аргументы: []стр) -> Итог(Настройки, ОшибкаЗапуска)
{
    изм настройки = Настройки{ действие: Сжать, уровень: поток.УРОВЕНЬ_ПО_УМОЛЧАНИЮ, версия: нет }
    цикл аргумент в аргументы[1..]
    {
        если не этоКлюч(аргумент)
        {
            продолжить
        }
        байты = аргумент.байты()
        если байты.длина == 2 и байты[1] >= б'1' и байты[1] <= б'9'
        {
            настройки.уровень = (байты[1] - б'0') как ц32
        }
        иначе если аргумент == "-d"
        {
            настройки.действие = Разжать
        }
        иначе если аргумент == "-t"
        {
            настройки.действие = Проверить
        }
        иначе если аргумент == "-l"
        {
            настройки.действие = Перечислить
        }
        иначе если аргумент == "-V" или аргумент == "--версия"
        {
            настройки.версия = да
        }
        иначе
        {
            попытка консоль.ошибка("сжать: неизвестный ключ ", аргумент, "\n", СПРАВКА)
            возврат Ошибка(Использование)
        }
    }
    возврат Успех(настройки)
}

функ этоКлюч(аргумент: стр) -> бул
{
    байты = аргумент.байты()
    возврат байты.длина > 1 и байты[0] == б'-'
}

функ обработать(путь: стр, настройки: &Настройки) требует Регион -> Итог(пусто, ОшибкаФайла)
{
    выбор настройки.действие
    {
        Сжать =>
        {
            куда = текст.формат("{}{}", путь, СУФФИКС)
            сводка = попытка поток.сжатьФайл(путь, куда, настройки.уровень)
            попытка консоль.печать(путь, ": ", сводка.прочитано, " → ", сводка.записано, " байт, ", экономия(сводка.прочитано, сводка.записано), " → ", куда)
        }
        Разжать =>
        {
            куда = попытка безСуффикса(путь)
            сводка = попытка поток.разжатьФайл(путь, куда)
            попытка консоль.печать(путь, ": ", сводка.прочитано, " → ", сводка.записано, " байт, членов ", сводка.членов, " → ", куда)
        }
        Проверить =>
        {
            сводка = попытка поток.проверитьФайл(путь)
            попытка консоль.печать(путь, ": цел, ", сводка.записано, " байт в ", сводка.членов, " членах")
        }
        Перечислить =>
        {
            опись = попытка поток.описатьФайл(путь)
            имя = выбор опись.имя
            {
                Есть(сохранённое) => сохранённое
                Ничего            => "—"
            }
            попытка консоль.печать(путь, ": ", опись.сводка.прочитано, " → ", опись.сводка.записано, " байт, ", экономия(опись.сводка.записано, опись.сводка.прочитано), ", имя в заголовке ", имя)
        }
    }
    возврат Успех()
}

функ безСуффикса(путь: стр) -> Итог(стр, ОшибкаФайла)
{
    байты = путь.байты()
    суффикс = СУФФИКС.байты()
    если байты.длина <= суффикс.длина или байты[байты.длина - суффикс.длина..] != суффикс
    {
        возврат Ошибка(НетСуффикса)
    }
    возврат Успех(путь.срез(0..байты.длина - суффикс.длина))
}

функ экономия(исходных: н64, сжатых: н64) требует Регион -> стр
{
    если исходных == 0
    {
        возврат "0,0 %"
    }
    промилле = ((исходных как ц64) - (сжатых как ц64)) * 1000 / (исходных как ц64)
    знак = выбор промилле < 0
    {
        да  => "-"
        нет => ""
    }
    величина = выбор промилле < 0
    {
        да  => -промилле
        нет => промилле
    }
    возврат текст.формат("{}{},{} %", знак, величина / 10, величина % 10)
}

функ ОшибкаФайла.описать(&сам) требует Регион -> стр
{
    возврат выбор сам
    {
        Сжатие(сбой) => сбой.описать()
        НетСуффикса  => текст.формат("нет суффикса {}: неясно, куда разжать", СУФФИКС)
        Вывод(сбой)  => текст.формат("не удалось напечатать: {}", сбой)
    }
}
