    отложить ввод.закрыть()
    черновик = попытка файл.Черновик.создать(куда)
    отложить черновик.отменить()
    сводка = попытка сжатьВ(&ввод, &черновик.файл, базовоеИмя(откуда), уровень)
    попытка черновик.сохранить()
    возврат Успех(сводка)
}

откр функ разжатьФайл(откуда: стр, куда: стр) требует Регион -> Итог(Сводка, ОшибкаСжатия)
