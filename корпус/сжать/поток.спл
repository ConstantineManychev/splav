откр функ описатьФайл(откуда: стр) требует Регион -> Итог(Опись, ОшибкаСжатия)
{
    ввод = попытка файл.ФайлСи.открыть(откуда)
    отложить ввод.закрыть()
    изм разжиматель = попытка Разжиматель.новый()
    отложить разжиматель.закрыть()
    сводка = попытка разжиматель.разжатьВсё(&ввод, Ничего)
    возврат Успех(Опись{ сводка, имя: разжиматель.имяВЗаголовке() })
}

функ сжатьВ(ввод: &файл.ФайлСи, вывод: &файл.ФайлСи, имя: стр, уровень: ц32) требует Регион -> Итог(Сводка, ОшибкаСжатия)
{
    изм сжиматель = попытка Сжиматель.новый(уровень, имя)
    отложить сжиматель.закрыть()
    возврат сжиматель.сжатьВсё(ввод, вывод)
}

функ разжатьВ(ввод: &файл.ФайлСи, вывод: ?&файл.ФайлСи) требует Регион -> Итог(Сводка, ОшибкаСжатия)
{
    изм разжиматель = попытка Разжиматель.новый()
    отложить разжиматель.закрыть()
    возврат разжиматель.разжатьВсё(ввод, вывод)
}

функ Сжиматель.новый(уровень: ц32, имя: стр) требует Регион -> Итог(Сжиматель, ОшибкаСжатия)
{
    поток = Регион.выделить(zlib.z_stream.ноль())
    попытка проверитьКод(опасно zlib.deflateInit2(поток, уровень, zlib.Z_DEFLATED, ОКНО_GZIP, ПАМЯТЬ_СЖАТИЯ, zlib.Z_DEFAULT_STRATEGY))
    сжиматель = Сжиматель{ поток }
    отложить сжиматель.закрыть()
    заголовок = Регион.выделить(zlib.gz_header.ноль())
    заголовок.name = текст.вСи(имя).указатель()
    заголовок.os = ОС_НЕИЗВЕСТНА
    попытка проверитьКод(опасно zlib.deflateSetHeader(сжиматель.поток, заголовок))
    возврат Успех(сжиматель)
}

функ Сжиматель.сжатьВсё(&изм сам, ввод: &файл.ФайлСи, вывод: &файл.ФайлСи) -> Итог(Сводка, ОшибкаСжатия)
{
    изм входной: [БЛОК]н8
    изм выходной: [БЛОК]н8
    изм сводка = Сводка{ прочитано: 0, записано: 0, членов: 1 }
    изм режим = zlib.Z_NO_FLUSH
    цикл режим != zlib.Z_FINISH
    {
        прочитано = попытка ввод.читать(входной[..])
        если прочитано < входной.длина
        {
            режим = zlib.Z_FINISH
        }
        сам.поток.next_in = входной[..прочитано].указатель()
        сам.поток.avail_in = прочитано как zlib.uInt
        сводка.прочитано += прочитано как н64
        сводка.записано += попытка сам.выдать(выходной[..], вывод, режим)
    }
    возврат Успех(сводка)
}

функ Сжиматель.выдать(&изм сам, выходной: []изм н8, вывод: &файл.ФайлСи, режим: ц32) -> Итог(н64, ОшибкаСжатия)
{
    изм всего: н64 = 0
    цикл
    {
        сам.поток.next_out = выходной.указатель()
        сам.поток.avail_out = выходной.длина как zlib.uInt
        код = опасно zlib.deflate(сам.поток, режим)
        если код == zlib.Z_STREAM_ERROR
        {
            возврат Ошибка(Библиотека(код))
        }
        готово = выходной.длина - сам.поток.avail_out как разм
        попытка вывод.писатьВсё(выходной[..готово])
        всего += готово как н64
        если сам.поток.avail_out != 0
        {
            возврат Успех(всего)
        }
    }
}

функ Сжиматель.закрыть(сам)
{
    Сжиматель{ поток } = сам
    _ = опасно zlib.deflateEnd(поток)
}

функ Разжиматель.новый() требует Регион -> Итог(Разжиматель, ОшибкаСжатия)
{
    поток = Регион.выделить(zlib.z_stream.ноль())
    попытка проверитьКод(опасно zlib.inflateInit2(поток, ОКНО_GZIP))
    имя = Регион.выделитьСрез(н8, МАКС_ИМЕНИ)
    заголовок = Регион.выделить(zlib.gz_header.ноль())
    заголовок.name = имя.указатель()
    заголовок.name_max = МАКС_ИМЕНИ как zlib.uInt
    разжиматель = Разжиматель{ поток, заголовок, имя }
    отложить разжиматель.закрыть()
    попытка проверитьКод(опасно zlib.inflateGetHeader(разжиматель.поток, разжиматель.заголовок))
    возврат Успех(разжиматель)
}

функ Разжиматель.разжатьВсё(&изм сам, ввод: &файл.ФайлСи, вывод: ?&файл.ФайлСи) -> Итог(Сводка, ОшибкаСжатия)
{
    изм входной: [БЛОК]н8
    изм выходной: [БЛОК]н8
    изм сводка = Сводка{ прочитано: 0, записано: 0, членов: 0 }
    изм внутриЧлена = нет
    цикл
    {
        если сам.поток.avail_in == 0
        {
            прочитано = попытка ввод.читать(входной[..])
            если прочитано == 0
            {
                прервать
            }
            сам.поток.next_in = входной[..прочитано].указатель()
            сам.поток.avail_in = прочитано как zlib.uInt
            сводка.прочитано += прочитано как н64
        }
        внутриЧлена = да
        сам.поток.next_out = выходной[..].указатель()
        сам.поток.avail_out = выходной.длина как zlib.uInt
        код = опасно zlib.inflate(сам.поток, zlib.Z_NO_FLUSH)
        готово = выходной.длина - сам.поток.avail_out как разм
        если вывод это Есть(приёмник)
        {
            попытка приёмник.писатьВсё(выходной[..готово])
        }
        сводка.записано += готово как н64
        если код == zlib.Z_STREAM_END
        {
            сводка.членов += 1
            внутриЧлена = нет
            попытка проверитьКод(опасно zlib.inflateReset(сам.поток))
        }
        иначе если код != zlib.Z_OK и код != zlib.Z_BUF_ERROR
        {
            возврат Ошибка(ошибкаРазжатия(код, сводка.прочитано - сам.поток.avail_in как н64))
        }
    }
    если внутриЧлена или сводка.членов == 0
    {
        возврат Ошибка(Обрезано)
    }
    возврат Успех(сводка)
}

функ Разжиматель.имяВЗаголовке(&сам) -> ?стр
{
    если сам.заголовок.done != 1 или сам.заголовок.name это Ничего
    {
        возврат Ничего
    }
    изм длина: разм = 0
    цикл длина < сам.имя.длина и сам.имя[длина] != 0
    {
        длина += 1
    }
    если стр.изUtf8(сам.имя[..длина]) это Успех(имя)
    {
        возврат Есть(имя)
    }
    возврат Ничего
}

функ Разжиматель.закрыть(сам)
{
    Разжиматель{ поток, заголовок: _, имя: _ } = сам
    _ = опасно zlib.inflateEnd(поток)
}

функ проверитьКод(код: ц32) -> Итог(пусто, ОшибкаСжатия)
{
    если код == zlib.Z_OK
    {
        возврат Успех()
    }
    если код == zlib.Z_MEM_ERROR
    {
        возврат Ошибка(НетПамяти)
    }
    возврат Ошибка(Библиотека(код))
}

функ ошибкаРазжатия(код: ц32, смещение: н64) -> ОшибкаСжатия
{
    если код == zlib.Z_DATA_ERROR или код == zlib.Z_NEED_DICT
    {
        возврат Повреждено(смещение)
    }
    если код == zlib.Z_MEM_ERROR
    {
        возврат НетПамяти
    }
    возврат Библиотека(код)
}

функ базовоеИмя(путь: стр) -> стр
{
    байты = путь.байты()
    изм начало = байты.длина
    цикл начало > 0 и байты[начало - 1] != б'/' и байты[начало - 1] != б'\\'
    {
        начало -= 1
    }
    возврат путь.срез(начало..байты.длина)
}

откр функ версияБиблиотеки() требует Регион -> стр
{
    опасно
    {
        если zlib.zlibVersion() это Есть(версия)
        {
            если стр.изUtf8(версия.доНуля()) это Успех(текстВерсии)
            {
                возврат текст.формат("{}", текстВерсии)
            }
        }
    }
    возврат "?"
}

откр функ версияЗаголовков() -> стр
{
    если стр.изUtf8(zlib.ZLIB_VERSION) это Успех(версия)
    {
        возврат версия
    }
    возврат "?"
}

откр функ ОшибкаСжатия.описать(&сам) требует Регион -> стр
{
    возврат выбор сам
    {
        Ввод(Система(код))   => файл.описание(код)
        Ввод(сбой)           => текст.формат("{}", сбой)
        Повреждено(смещение) => текст.формат("данные повреждены около байта {}", смещение)
        Обрезано             => "файл обрезан: поток gzip не закончен"
        НетПамяти            => "zlib: не хватило памяти"
        Библиотека(код)      => текст.формат("zlib вернула код {}", код)
    }
}

