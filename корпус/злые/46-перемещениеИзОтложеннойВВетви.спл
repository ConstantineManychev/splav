функ создатьИОтдать(путь: стр, отдать: бул) -> Итог(пусто, ос.ОшибкаВвода)
{
    файл = попытка фс.Файл.создать(путь)
    отложить файл.закрыть()
    попытка файл.писать("заголовок\n".байты())
    если отдать
    {
        передать(файл)
    }
    возврат Успех()
}

функ передать(файл: фс.Файл)
{
    файл.закрыть()
}

функ вход() -> Итог(пусто, ос.ОшибкаВвода)
{
    попытка создатьИОтдать("журнал.txt", да)
    возврат Успех()
}
