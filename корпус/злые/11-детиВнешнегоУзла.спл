подключить ядро.журнал

структ Узел
{
    имя: стр
    дети: Массив(&Узел)
}

функ собрать()
{
    регион внешний
    {
        корень = Регион.выделить(Узел{ имя: "корень", дети: Массив(&Узел).новый() })
        регион внутренний
        {
            лист = Регион.выделить(Узел{ имя: "лист", дети: Массив(&Узел).новый() })
            корень.дети.добавить(лист)
        }
        журнал.сообщить(корень.дети.количество())
    }
}
