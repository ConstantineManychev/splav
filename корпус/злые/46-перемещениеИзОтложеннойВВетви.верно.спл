функ создатьСЗаголовком(путь: стр) -> Итог(фс.Файл, ос.ОшибкаВвода)
{
    файл = попытка фс.Файл.создать(путь)
    отложить файл.закрыть()
    попытка файл.писать("заголовок\n".байты())
    возврат Успех(файл)
}

функ вход() -> Итог(пусто, ос.ОшибкаВвода)
{
    файл = попытка создатьСЗаголовком("журнал.txt")
    отложить файл.закрыть()
    попытка файл.писать("запись\n".байты())
    возврат Успех()
}
