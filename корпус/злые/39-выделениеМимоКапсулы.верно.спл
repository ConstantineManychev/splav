подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ добавить(список: &изм Список, значение: ц64)
{
    через список.рег
    {
        список.голова = Есть(Регион.выделить(Узел{ значение, дальше: список.голова }))
    }
}
