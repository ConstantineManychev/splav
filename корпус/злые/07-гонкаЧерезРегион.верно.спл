подключить ядро.журнал
подключить ядро.текст

структ Счётчик
{
    значение: ц64
}

функ увеличить(счётчик: &изм Счётчик, раз: ц64)
{
    цикл _ в 0..раз
    {
        счётчик.значение += 1
    }
}

функ вход()
{
    изм первый = Счётчик{ значение: 0 }
    изм второй = Счётчик{ значение: 0 }
    вместе(увеличить(&изм первый, 1000), увеличить(&изм второй, 1000))
    регион
    {
        журнал.сообщить(текст.формат("итог: {}", первый.значение + второй.значение))
    }
}
