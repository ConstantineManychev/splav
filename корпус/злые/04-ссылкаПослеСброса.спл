подключить ядро.журнал
подключить ядро.память

конст МЕГАБАЙТ: разм = 1024 * 1024

структ Кадр
{
    номер: н64
    подпись: стр
}

функ вход()
{
    изм кадры = память.новыйРегион(МЕГАБАЙТ)
    отложить кадры.освободить()
    изм последний: ?&Кадр = Ничего
    через кадры
    {
        последний = Есть(Регион.выделить(Кадр{ номер: 1, подпись: "первый" }))
    }
    кадры = кадры.сбросить()
    если последний это Есть(кадр)
    {
        журнал.сообщить(кадр.подпись)
    }
}
