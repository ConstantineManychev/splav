подключить ядро.ос

функ обслужить(соединение: tcp.Соединение)
{
    отложить соединение.закрыть()
    _ = соединение.писатьВсё("принято\n".байты())
}

функ принимать(слушатель: &tcp.Слушатель) -> Итог(никогда, ос.ОшибкаВвода)
{
    вместе
    {
        цикл
        {
            соединение = попытка слушатель.принять()
            запуск обслужить(соединение)
        }
    }
}

функ вход() -> Итог(пусто, ос.ОшибкаВвода)
{
    слушатель = попытка tcp.слушать("0.0.0.0:7007")
    отложить слушатель.закрыть()
    возврат принимать(&слушатель)
}
