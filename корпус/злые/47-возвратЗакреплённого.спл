[Закреплённый]
структ Ожидание
{
    состояние: н32
    следующее: ?*Ожидание
}

функ встать(ожидание: &изм Ожидание)
{
    ожидание.состояние = 1
}

функ ждать() -> Ожидание
{
    изм ожидание: Ожидание
    встать(&изм ожидание)
    возврат ожидание
}

функ вход()
{
    ожидание = ждать()
    если ожидание.состояние == 1
    {
        возврат
    }
}
