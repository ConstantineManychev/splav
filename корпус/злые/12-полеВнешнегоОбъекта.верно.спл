подключить ядро.журнал

структ Узел
{
    имя: стр
    сосед: ?&Узел
}

функ соединить()
{
    регион внешний
    {
        корень = Регион.выделить(Узел{ имя: "корень", сосед: Ничего })
        лист = Регион.выделить(Узел{ имя: "лист", сосед: Ничего })
        регион внутренний
        {
            корень.сосед = Есть(лист)
        }
        журнал.сообщить(корень.имя)
    }
}
