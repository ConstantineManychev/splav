подключить ядро.канал
подключить ядро.фс

функ передать(файл: фс.Файл)
{
    (передатчик, приёмник) = канал.новый(фс.Файл, 1)
    выбор передатчик.отправить(файл)
    {
        Успех()      => {}
        Ошибка(сбой) => сбой.забрать().закрыть()
    }
    передатчик.закрыть()
    приёмник.закрыть()
}
