подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ закрыть(список: Список)
{
    Список{ рег, голова: _ } = список
    рег.освободить()
}

функ первоеИЗакрыть(список: Список) -> ц64
{
    изм значение: ц64 = 0
    если список.голова это Есть(узел)
    {
        значение = узел.значение
    }
    закрыть(список)
    возврат значение
}
