подключить ядро.память
подключить ядро.журнал

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ собрать() -> Список
{
    изм рег = память.новыйРегион(4096)
    изм голова: ?&Узел = Ничего
    через рег
    {
        голова = Есть(Регион.выделить(Узел{ значение: 1, дальше: Ничего }))
    }
    возврат Список{ рег, голова }
}

функ закрыть(список: Список)
{
    Список{ рег, голова: _ } = список
    рег.освободить()
}

функ вход()
{
    список = собрать()
    голова = список.голова
    если голова это Есть(узел)
    {
        журнал.сообщить(узел.значение)
    }
    закрыть(список)
}
