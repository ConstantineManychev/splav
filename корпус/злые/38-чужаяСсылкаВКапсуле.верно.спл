подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ подцепить(список: &изм Список, внешний: &Узел)
{
    через список.рег
    {
        список.голова = Есть(Регион.выделить(Узел{ значение: внешний.значение, дальше: список.голова }))
    }
}
