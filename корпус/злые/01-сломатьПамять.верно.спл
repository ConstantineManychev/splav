подключить ядро.журнал

структ Узел
{
    имя: стр
    дети: Массив(&Узел)
    родитель: ?&Узел
}

функ новыйУзел(имя: стр) требует Регион -> &изм Узел
{
    возврат Регион.выделить(Узел{ имя, дети: Массив(&Узел).новый(), родитель: Ничего })
}

функ привязатьРодителя(узел: &изм Узел, родитель: &Узел)
{
    узел.родитель = Есть(родитель)
}

функ напечататьДерево(узел: &Узел)
{
    журнал.сообщить(узел.имя)
    если узел.родитель это Есть(родитель)
    {
        напечататьДерево(родитель)
    }
}

функ сломатьПамять()
{
    регион внешний
    {
        корень = новыйУзел("корень")
        временный = новыйУзел("временный")
        привязатьРодителя(корень, временный)
        напечататьДерево(корень)
    }
}

функ вход()
{
    сломатьПамять()
}
