подключить ядро.память

структ Кадр
{
    рег: память.Рег
    номер: н64
}

структ Кадры
{
    текущий: Кадр
    прошлый: Кадр
}

функ освободить(кадры: Кадры)
{
    Кадры{ текущий, прошлый } = кадры
    Кадр{ рег: первый, номер: _ } = текущий
    Кадр{ рег: второй, номер: _ } = прошлый
    первый.освободить()
    второй.освободить()
}
