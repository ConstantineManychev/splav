подключить ядро.память
подключить ядро.журнал

структ Счёт
{
    рег: память.Рег
    очки: ц64
}

функ запомнить(счёт: Счёт)
{
    общий = память.заморозить(счёт)
    отложить общий.освободить()
    регион
    {
        изм ссылки = Массив(&Счёт).новый()
        ссылки.добавить(общий.данные())
        журнал.сообщить(ссылки.количество())
    }
}
