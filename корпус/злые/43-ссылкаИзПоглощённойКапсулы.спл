подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ закрыть(список: Список)
{
    Список{ рег, голова: _ } = список
    рег.освободить()
}

функ первоеИЗакрыть(список: Список) -> ?&Узел
{
    голова = список.голова
    закрыть(список)
    возврат голова
}
