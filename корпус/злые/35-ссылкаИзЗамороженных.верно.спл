подключить ядро.память
подключить ядро.журнал

структ Счёт
{
    рег: память.Рег
    очки: ц64
}

функ запомнить(счёт: Счёт)
{
    общий = память.заморозить(счёт)
    отложить общий.освободить()
    регион
    {
        изм очки = Массив(ц64).новый()
        очки.добавить(общий.данные().очки)
        журнал.сообщить(очки.количество())
    }
}
