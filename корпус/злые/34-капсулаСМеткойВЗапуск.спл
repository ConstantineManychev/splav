подключить ядро.память
подключить ядро.журнал

структ Настройки
{
    глубина: ц64
}

структ Задание
{
    рег: память.Рег
    настройки: &р Настройки
}

функ выполнить(задание: Задание)
{
    Задание{ рег, настройки } = задание
    журнал.сообщить(настройки.глубина)
    рег.освободить()
}

функ раздать(настройки: &Настройки)
{
    задание = Задание{ рег: память.новыйРегион(4096), настройки }
    вместе
    {
        запуск выполнить(задание)
    }
}
