подключить ядро.журнал

конст РАЗМЕР: разм = 4096

функ заполнить(часть: []изм н8, значение: н8)
{
    цикл индекс в 0..часть.длина
    {
        часть[индекс] = значение
    }
}

функ вход()
{
    изм буфер: [РАЗМЕР]н8
    вместе(заполнить(буфер[..], 1), заполнить(буфер[..], 2))
    если буфер[0] != буфер[РАЗМЕР - 1]
    {
        журнал.сообщить("половины записаны разными задачами")
    }
}
