подключить ядро.память
подключить ядро.журнал

структ Узел
{
    имя: стр
}

функ работать()
{
    изм рег = память.новыйРегион(4096)
    изм узел: ?&Узел = Ничего
    через рег
    {
        узел = Есть(Регион.выделить(Узел{ имя: "узел" }))
    }
    рег.освободить()
    если узел это Есть(найденный)
    {
        журнал.сообщить(найденный.имя)
    }
}
