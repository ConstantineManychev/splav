подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ закрыть(список: Список)
{
    Список{ рег, голова: _ } = список
    рег.освободить()
}

функ сменить(список: &изм Список, новый: Список)
{
    прежний = память.заменить(список, новый)
    закрыть(прежний)
}
