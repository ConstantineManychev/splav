подключить ядро.журнал

структ Настройки
{
    уровень: ц32
}

структ Задача
{
    имя: стр
    настройки: &Настройки
}

функ создатьЗадачу(имя: стр, настройки: &Настройки) требует Регион -> &Задача
{
    возврат Регион.выделить(Задача{ имя, настройки })
}

функ задачаСборки() требует Регион -> &Задача
{
    настройки = Регион.выделить(Настройки{ уровень: 3 })
    возврат создатьЗадачу("сборка", настройки)
}

функ вход()
{
    регион
    {
        задача = задачаСборки()
        если задача.настройки.уровень > 2
        {
            журнал.сообщить(задача.имя)
        }
    }
}
