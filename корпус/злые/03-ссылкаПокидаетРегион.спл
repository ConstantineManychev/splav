подключить ядро.журнал

структ Сообщение
{
    текст: стр
}

функ вход()
{
    изм последнее: ?&Сообщение = Ничего
    регион
    {
        сообщение = Регион.выделить(Сообщение{ текст: "готово" })
        последнее = Есть(сообщение)
    }
    если последнее это Есть(прочитанное)
    {
        журнал.сообщить(прочитанное.текст)
    }
}
