подключить ядро.журнал

переч Значение
{
    Число(ц64)
    Текст(стр)
}

функ текстВнутри(значение: &Значение) -> ?стр
{
    возврат выбор значение
    {
        Текст(текст) => Есть(текст)
        Число(_)     => Ничего
    }
}

функ подменить(значение: &изм Значение)
{
    если текстВнутри(значение) это Есть(текст)
    {
        *значение = Значение.Число(0x4142_4344)
        журнал.сообщить(текст)
    }
}

функ вход()
{
    регион
    {
        значение = Регион.выделить(Значение.Текст("строка"))
        подменить(значение)
    }
}
