подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ упаковать(внешний: &Узел) -> Список
{
    изм рег = память.новыйРегион(4096)
    изм голова: ?&Узел = Ничего
    через рег
    {
        голова = Есть(Регион.выделить(Узел{ значение: внешний.значение, дальше: Ничего }))
    }
    возврат Список{ рег, голова }
}
