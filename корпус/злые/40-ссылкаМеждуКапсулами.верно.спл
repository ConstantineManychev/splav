подключить ядро.память

структ Узел
{
    значение: ц64
    дальше: ?&Узел
}

структ Список
{
    рег: память.Рег
    голова: ?&Узел
}

функ перенести(куда: &изм Список, откуда: &Список)
{
    если откуда.голова это Есть(узел)
    {
        через куда.рег
        {
            куда.голова = Есть(Регион.выделить(Узел{ значение: узел.значение, дальше: куда.голова }))
        }
    }
}
