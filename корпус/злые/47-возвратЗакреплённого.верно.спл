[Закреплённый]
структ Ожидание
{
    состояние: н32
    следующее: ?*Ожидание
}

функ встать(ожидание: &изм Ожидание)
{
    ожидание.состояние = 1
}

функ ждать(ожидание: &изм Ожидание)
{
    встать(ожидание)
}

функ вход()
{
    изм ожидание: Ожидание
    ждать(&изм ожидание)
    если ожидание.состояние == 1
    {
        возврат
    }
}
