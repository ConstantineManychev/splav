подключить ядро.фс

переч Ресурс
{
    Открыт(фс.Файл)
    Закрыт
}

функ закрыть(ресурс: Ресурс)
{
    выбор ресурс
    {
        Открыт(файл) => файл.закрыть()
        Закрыт       => {}
    }
}

функ дописать(ресурс: Ресурс)
{
    выбор &ресурс
    {
        Открыт(файл) =>
        {
            закрыть(ресурс)
            _ = файл.писать("конец".байты())
        }
        Закрыт => закрыть(ресурс)
    }
}
