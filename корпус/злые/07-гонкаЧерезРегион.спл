подключить ядро.журнал
подключить ядро.текст

структ Счётчик
{
    значение: ц64
}

функ увеличить(счётчик: &изм Счётчик, раз: ц64)
{
    цикл _ в 0..раз
    {
        счётчик.значение += 1
    }
}

функ вход()
{
    регион
    {
        счётчик = Регион.выделить(Счётчик{ значение: 0 })
        вместе(увеличить(счётчик, 1000), увеличить(счётчик, 1000))
        журнал.сообщить(текст.формат("итог: {}", счётчик.значение))
    }
}
