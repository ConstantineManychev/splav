[Тест]
подключить ядро.тест

конст АДРЕС = "0.0.0.0:7007"
конст РАЗМЕР_БУФЕРА = 16 * 1024
конст ПРОСТОЙ = время.секунды(30)
конст ПАУЗА_ПРИЁМА = время.миллисекунды(100)
конст ОшибкаЭха = время.ОшибкаСрока(ос.ОшибкаВвода)

функ вход() -> Итог(пусто, ос.ОшибкаВвода)
{
    итог = работать(АДРЕС)
    если итог это Ошибка(сбой)
    {
        журнал.ошибка(сбой)
    }
    возврат итог
}

функ работать(адрес: стр) -> Итог(пусто, ос.ОшибкаВвода)
{
    слушатель = попытка tcp.слушать(адрес)
    отложить слушатель.закрыть()
    журнал.сообщить("эхо-сервер запущен")
    возврат вместе.первый(
        функ() => принимать(&слушатель, ПРОСТОЙ),
        функ() => ждатьОстановки(),
    )
}

функ ждатьОстановки() -> Итог(пусто, ос.ОшибкаВвода)
{
    попытка ос.ждатьПрерывания()
    журнал.сообщить("остановка по сигналу")
    возврат Успех()
}

функ принимать(
    слушатель: &tcp.Слушатель,
    простой: время.Длительность,
) -> Итог(никогда, ос.ОшибкаВвода)
{
    вместе
    {
        цикл
        {
            выбор слушатель.принять()
            {
                Успех(соединение)                 => запуск обслужить(соединение, простой)
                Ошибка(сбой) если сбой.временная() =>
                {
                    журнал.предупредить(сбой)
                    _ = время.спать(ПАУЗА_ПРИЁМА)
                }
                Ошибка(сбой)                      => возврат Ошибка(сбой)
            }
        }
    }
}

функ обслужить(соединение: tcp.Соединение, простой: время.Длительность)
{
    отложить соединение.закрыть()
    выбор эхо(&соединение, простой)
    {
        Успех() или Ошибка(Внутри(Отменено)) => {}
        Ошибка(Истекло)                      => журнал.сообщить("соединение закрыто по простою")
        Ошибка(Внутри(сбой))                 => журнал.предупредить(сбой)
    }
}

функ эхо(соединение: &tcp.Соединение, простой: время.Длительность) -> Итог(пусто, ОшибкаЭха)
{
    изм буфер: [РАЗМЕР_БУФЕРА]н8
    цикл
    {
        прочитано = попытка время.неДольше(простой, функ() => соединение.читать(буфер[..]))
        если прочитано == 0
        {
            возврат Успех()
        }
        попытка время.неДольше(простой, функ() => соединение.писатьВсё(буфер[..прочитано]))
    }
}

[Тест]
конст РАЗМЕР_ЗАПРОСА = 64 * 1024

[Тест]
конст ПЕРИОД_УЗОРА = 251

[Тест(предел: время.секунды(10))]
функ возвращаетОтправленное() -> Итог(пусто, тест.Провал)
{
    слушатель = попытка тест.ожидатьУспех(tcp.слушать("127.0.0.1:0"))
    отложить слушатель.закрыть()
    адрес = слушатель.адрес()
    изм запрос: [РАЗМЕР_ЗАПРОСА]н8
    цикл номер в 0..запрос.длина
    {
        запрос[номер] = (номер % ПЕРИОД_УЗОРА) как н8
    }
    совпало = попытка тест.ожидатьУспех(вместе.первый(
        функ() => принимать(&слушатель, ПРОСТОЙ),
        функ() => спросить(адрес, запрос[..]),
    ))
    попытка тест.ожидать(совпало)
    возврат Успех()
}

[Тест(предел: время.секунды(10))]
функ закрываетПростаивающее() -> Итог(пусто, тест.Провал)
{
    слушатель = попытка тест.ожидатьУспех(tcp.слушать("127.0.0.1:0"))
    отложить слушатель.закрыть()
    адрес = слушатель.адрес()
    прочитано = попытка тест.ожидатьУспех(вместе.первый(
        функ() => принимать(&слушатель, время.миллисекунды(50)),
        функ() => молчатьДоЗакрытия(адрес),
    ))
    попытка тест.ожидатьРавно(прочитано, 0)
    возврат Успех()
}

[Тест]
функ спросить(адрес: tcp.Адрес, запрос: []н8) -> Итог(бул, ос.ОшибкаВвода)
{
    соединение = попытка tcp.подключиться(адрес)
    отложить соединение.закрыть()
    изм ответ: [РАЗМЕР_ЗАПРОСА]н8
    приём = ответ[..запрос.длина]
    попытка вместе(соединение.писатьВсё(запрос), соединение.читатьРовно(приём))
    возврат Успех(приём == запрос)
}

[Тест]
функ молчатьДоЗакрытия(адрес: tcp.Адрес) -> Итог(разм, ос.ОшибкаВвода)
{
    соединение = попытка tcp.подключиться(адрес)
    отложить соединение.закрыть()
    изм байт: [1]н8
    прочитано = попытка соединение.читать(байт[..])
    возврат Успех(прочитано)
}
