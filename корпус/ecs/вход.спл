подключить ядро.память
подключить ядро.фс
подключить ядро.ос
подключить ядро.текст
подключить ядро.журнал
подключить ecs
подключить летопись

конст КАДРОВ: разм = 600
конст ДТ: в32 = 0.016
конст МЕГАБАЙТ: разм = 1048576
конст ВРАГОВ_В_РЯДУ: н32 = 16
конст РЯДОВ: н32 = 4

функ вход() -> Итог(пусто, ос.ОшибкаВвода)
{
    журналКадров = попытка фс.Файл.создать("кадры.txt")
    отложить журналКадров.закрыть()
    регион
    {
        изм мир = ecs.Мир.новый()
        заселить(&изм мир)
        изм кадр = память.новыйРегион(МЕГАБАЙТ)
        отложить кадр.освободить()
        изм хроника = летопись.Летопись.новая(МЕГАБАЙТ)
        отложить хроника.закрыть()
        цикл номер в 0..КАДРОВ
        {
            через кадр
            {
                изм команды = Массив(ecs.Команда).новый()
                если номер % 10 == 0
                {
                    выстрелить(&изм мир, номер)
                }
                ecs.шаг(&изм мир, &изм команды, ДТ)
                если номер % 60 == 0
                {
                    (здоровье, пуль) = ecs.сводка(&мир)
                    строка = текст.формат(
                        "кадр {}: врагов {}, пуль {}, здоровье {}, счёт {}\n",
                        номер,
                        мир.враги.количество(),
                        пуль,
                        здоровье,
                        мир.счёт,
                    )
                    попытка журналКадров.писать(строка.байты())
                    хроника.записать(номер, мир.счёт)
                }
            }
            кадр = кадр.сбросить()
        }
        журнал.сообщить("счёт: ", мир.счёт)
        если хроника.свежее() это Есть(событие)
        {
            журнал.сообщить("последняя запись: кадр ", событие.кадр, ", записей ", хроника.записей)
        }
    }
    возврат Успех()
}

функ заселить(мир: &изм ecs.Мир)
{
    цикл ряд в 0..РЯДОВ
    {
        цикл столбец в 0..ВРАГОВ_В_РЯДУ
        {
            позиция = ecs.Век2{ (столбец как в32) * 2.0, 20.0 + (ряд как в32) * 2.0 }
            _ = мир.создатьВрага(позиция, ecs.Век2{ 0.0, -0.5 }, 3)
        }
    }
}

функ выстрелить(мир: &изм ecs.Мир, номер: разм)
{
    столбец = ((номер / 10) % 16) как в32
    _ = мир.создатьПулю(ecs.Век2{ столбец * 2.0, 0.0 }, ecs.Век2{ 0.0, 12.0 }, 1)
}
