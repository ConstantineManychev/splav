функ устаревшаяСсылкаНеЖива() требует Регион -> Итог(пусто, тест.Провал)
{
    изм мир = Мир.новый()
    первый = мир.создатьВрага(Век2{ 0.0, 0.0 }, Век2{ 0.0, 0.0 }, 1)
    мир.удалить(первый)
    второй = мир.создатьВрага(Век2{ 1.0, 0.0 }, Век2{ 0.0, 0.0 }, 1)
    попытка тест.ожидатьРавно(второй.номер, первый.номер)
    попытка тест.ожидать(не мир.жива(первый))
    попытка тест.ожидать(мир.жива(второй))
    возврат Успех()
}

