[Тест]
подключить ядро.тест

откр конст Век2 = Вектор(в32, 2)

конст РАДИУС_ПОПАДАНИЯ: в32 = 0.5
конст ВРЕМЯ_ПУЛИ: в32 = 3.0

откр структ Сущность
{
    откр номер: н32
    откр поколение: н32
}

откр переч Таблица
{
    Враги
    Пули
}

структ Запись
{
    поколение: н32
    таблица: Таблица
    строка: н32
    занята: бул
}

откр набор Враг
{
    откр позиция: Век2
    откр скорость: Век2
    откр здоровье: ц32
}

откр набор Пуля
{
    откр позиция: Век2
    откр скорость: Век2
    откр урон: ц32
    откр осталось: в32
}

откр переч Команда
{
    Урон(цель: Сущность, сколько: ц32)
    Удалить(Сущность)
}

откр структ Мир
{
    записи: Массив(Запись)
    свободные: Массив(н32)
    откр враги: Массив(Враг)
    владельцыВрагов: Массив(Сущность)
    откр пули: Массив(Пуля)
    владельцыПуль: Массив(Сущность)
    откр счёт: ц64
}

откр функ Мир.новый() требует Регион -> Мир
{
    возврат Мир{
        записи: Массив(Запись).новый(),
        свободные: Массив(н32).новый(),
        враги: Массив(Враг).новый(),
        владельцыВрагов: Массив(Сущность).новый(),
        пули: Массив(Пуля).новый(),
        владельцыПуль: Массив(Сущность).новый(),
        счёт: 0,
    }
}

откр функ Мир.создатьВрага(&изм сам, позиция: Век2, скорость: Век2, здоровье: ц32) -> Сущность
{
    сущность = сам.выдать(Враги, сам.враги.количество() как н32)
    сам.враги.добавить(Враг{ позиция, скорость, здоровье })
    сам.владельцыВрагов.добавить(сущность)
    возврат сущность
}

откр функ Мир.создатьПулю(&изм сам, позиция: Век2, скорость: Век2, урон: ц32) -> Сущность
{
    сущность = сам.выдать(Пули, сам.пули.количество() как н32)
    сам.пули.добавить(Пуля{ позиция, скорость, урон, осталось: ВРЕМЯ_ПУЛИ })
    сам.владельцыПуль.добавить(сущность)
    возврат сущность
}

откр функ Мир.жива(&сам, сущность: Сущность) -> бул
{
    номер = сущность.номер как разм
    если номер >= сам.записи.количество()
    {
        возврат нет
    }
    запись = сам.записи[номер]
    возврат запись.занята и запись.поколение == сущность.поколение
}

откр функ Мир.здоровье(&сам, враг: Сущность) -> ?ц32
{
    если не сам.жива(враг)
    {
        возврат Ничего
    }
    запись = сам.записи[враг.номер как разм]
    возврат Есть(сам.враги[запись.строка как разм].здоровье)
}

откр функ Мир.удалить(&изм сам, сущность: Сущность)
{
    если не сам.жива(сущность)
    {
        возврат
    }
    запись = сам.записи[сущность.номер как разм]
    строка = запись.строка как разм
    выбор запись.таблица
    {
        Враги =>
        {
            _ = сам.враги.удалитьПеренося(строка)
            _ = сам.владельцыВрагов.удалитьПеренося(строка)
            если строка < сам.владельцыВрагов.количество()
            {
                сам.переписать(сам.владельцыВрагов[строка], строка)
            }
        }
        Пули =>
        {
            _ = сам.пули.удалитьПеренося(строка)
            _ = сам.владельцыПуль.удалитьПеренося(строка)
            если строка < сам.владельцыПуль.количество()
            {
                сам.переписать(сам.владельцыПуль[строка], строка)
            }
        }
    }
    освобождённая = &изм сам.записи[сущность.номер как разм]
    освобождённая.занята = нет
    освобождённая.поколение +%= 1
    сам.свободные.добавить(сущность.номер)
}

функ Мир.выдать(&изм сам, таблица: Таблица, строка: н32) -> Сущность
{
    если сам.свободные.снять() это Есть(свободный)
    {
        запись = &изм сам.записи[свободный как разм]
        запись.таблица = таблица
        запись.строка = строка
        запись.занята = да
        возврат Сущность{ номер: свободный, поколение: запись.поколение }
    }
    номер = сам.записи.количество() как н32
    сам.записи.добавить(Запись{ поколение: 0, таблица, строка, занята: да })
    возврат Сущность{ номер, поколение: 0 }
}

функ Мир.переписать(&изм сам, сущность: Сущность, строка: разм)
{
    запись = &изм сам.записи[сущность.номер как разм]
    запись.строка = строка как н32
}

функ Мир.ранить(&изм сам, цель: Сущность, сколько: ц32)
{
    если не сам.жива(цель)
    {
        возврат
    }
    строка = сам.записи[цель.номер как разм].строка как разм
    сам.враги[строка].здоровье -= сколько
    если сам.враги[строка].здоровье <= 0
    {
        сам.счёт += 1
        сам.удалить(цель)
    }
}

откр функ шаг(мир: &изм Мир, команды: &изм Массив(Команда), дт: в32)
{
    двигатьВрагов(&изм мир.враги, дт)
    двигатьПули(мир, команды, дт)
    столкновения(мир, команды)
    применить(мир, команды)
}

функ двигатьВрагов(враги: &изм Массив(Враг), дт: в32)
{
    цикл номер в 0..враги.количество()
    {
        враги[номер].позиция += враги[номер].скорость * дт
    }
}

функ двигатьПули(мир: &изм Мир, команды: &изм Массив(Команда), дт: в32)
{
    цикл номер в 0..мир.пули.количество()
    {
        мир.пули[номер].позиция += мир.пули[номер].скорость * дт
        мир.пули[номер].осталось -= дт
        если мир.пули[номер].осталось <= 0.0
        {
            команды.добавить(Удалить(мир.владельцыПуль[номер]))
        }
    }
}

функ столкновения(мир: &Мир, команды: &изм Массив(Команда))
{
    цикл п в 0..мир.пули.количество()
    {
        пуля = мир.пули[п]
        цикл ц в 0..мир.враги.количество()
        {
            разница = мир.враги[ц].позиция - пуля.позиция
            если разница.х * разница.х + разница.у * разница.у < РАДИУС_ПОПАДАНИЯ * РАДИУС_ПОПАДАНИЯ
            {
                команды.добавить(Урон(мир.владельцыВрагов[ц], пуля.урон))
                команды.добавить(Удалить(мир.владельцыПуль[п]))
                прервать
            }
        }
    }
}

функ применить(мир: &изм Мир, команды: &Массив(Команда))
{
    цикл команда в команды
    {
        выбор команда
        {
            Урон(цель, сколько) => мир.ранить(цель, сколько)
            Удалить(сущность)   => мир.удалить(сущность)
        }
    }
}

откр функ сводка(мир: &Мир) -> (ц64, разм)
{
    возврат вместе(суммаЗдоровья(&мир.враги), живыхПуль(&мир.пули))
}

функ суммаЗдоровья(враги: &Массив(Враг)) -> ц64
{
    изм сумма: ц64 = 0
    цикл враг в враги
    {
        сумма += враг.здоровье как ц64
    }
    возврат сумма
}

функ живыхПуль(пули: &Массив(Пуля)) -> разм
{
    изм живых: разм = 0
    цикл пуля в пули
    {
        если пуля.осталось > 0.0
        {
            живых += 1
        }
    }
    возврат живых
}

