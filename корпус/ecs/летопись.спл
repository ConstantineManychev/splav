подключить ядро.память

откр структ Событие
{
    откр кадр: разм
    откр счёт: ц64
    откр прошлое: ?&Событие
}

откр структ Летопись
{
    рег: память.Рег
    последнее: ?&Событие
    откр записей: н64
}

откр функ Летопись.новая(байт: разм) -> Летопись
{
    возврат Летопись{ рег: память.новыйРегион(байт), последнее: Ничего, записей: 0 }
}

откр функ Летопись.записать(&изм сам, кадр: разм, счёт: ц64)
{
    через сам.рег
    {
        сам.последнее = Есть(Регион.выделить(Событие{ кадр, счёт, прошлое: сам.последнее }))
    }
    сам.записей += 1
}

откр функ Летопись.свежее(&сам) -> ?&Событие
{
    возврат сам.последнее
}

откр функ Летопись.закрыть(сам)
{
    Летопись{ рег, последнее: _, записей: _ } = сам
    рег.освободить()
}
