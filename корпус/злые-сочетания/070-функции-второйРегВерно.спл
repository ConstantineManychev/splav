структ Кадр20
{
    рег: память.Рег
    номер: н64
}

структ Кадры20
{
    текущий: Кадр20
    прошлый: Кадр20
}

функ освободитьКадры20(кадры: Кадры20)
{
    Кадры20{ текущий, прошлый } = кадры
    Кадр20{ рег: первый, номер: _ } = текущий
    Кадр20{ рег: второй, номер: _ } = прошлый
    первый.освободить()
    второй.освободить()
}
