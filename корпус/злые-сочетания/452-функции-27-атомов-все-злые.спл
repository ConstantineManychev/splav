функ наибольший16(числа: []ц64) -> &ц64
{
    изм лучший: ц64 = 0
    цикл число в числа
    {
        если *число > лучший
        {
            лучший = *число
        }
    }
    возврат &лучший
}

функ скопировать17(откуда: стр, куда: стр) -> Итог(пусто, ос.ОшибкаВвода)
{
    источник = попытка фс.Файл.открыть(откуда)
    приёмник = попытка фс.Файл.создать(куда)
    источник.закрыть()
    приёмник.закрыть()
    возврат Успех()
}

функ первыеБайты18(путь: стр) -> Итог(разм, ос.ОшибкаВвода)
{
