функ новоеЗвено23() требует Регион -> &изм Звено23
{
    возврат Регион.выделить(Звено23{ дети: Массив(&Звено23).новый(), родитель: Ничего })
}

функ привязать23(узел: &изм Звено23, родитель: &Звено23)
{
    узел.родитель = Есть(родитель)
}

функ связать23()
{
    регион внешний
    {
        корень = новоеЗвено23()
        регион внутренний
        {
            временный = новоеЗвено23()
            привязать23(корень, временный)
        }
    }
}
