функ заполнить(часть: []изм н8, значение: н8)
{
    цикл индекс в 0..часть.длина
    {
        часть[индекс] = значение
    }
}

функ увеличить(значение: &изм ц64)
{
    *значение += 1
}

функ освободитьУзел(узел: Уник(Узел))
{
    узел.освободить()
}

функ прочитатьУзел(узел: &Узел)
{
    сумма = узел.значение + 1
}

функ прочитатьКопию(узел: Узел)
