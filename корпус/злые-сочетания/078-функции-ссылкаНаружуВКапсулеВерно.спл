структ Бусина24
{
    значение: ц64
    дальше: ?&Бусина24
}

структ Нить24
{
    рег: память.Рег
    голова: ?&Бусина24
}

функ упаковать24(внешняя: &Бусина24) -> Нить24
{
    изм рег = память.новыйРегион(4096)
    изм голова: ?&Бусина24 = Ничего
    через рег
    {
        голова = Есть(Регион.выделить(Бусина24{ значение: внешняя.значение, дальше: Ничего }))
    }
    возврат Нить24{ рег, голова }
}
