функ проверка()
{
    изм последнее7: ?&Узел = Ничего
    регион
    {
        узел7 = Регион.выделить(Узел{ значение: 4 })
        последнее7 = Есть(узел7)
    }
    если последнее7 это Есть(прочитанное7)
    {
        сумма7 = прочитанное7.значение + 1
    }

    изм рег6 = память.новыйРегион(4096)
    изм узел6: ?&Узел = Ничего
    через рег6
    {
        узел6 = Есть(Регион.выделить(Узел{ значение: 3 }))
    }
    рег6.освободить()
    если узел6 это Есть(найденный6)
    {
        сумма6 = найденный6.значение + 1
    }
}
