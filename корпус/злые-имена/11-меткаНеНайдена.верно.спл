функ естьОтрицательное(строки: [][]ц64) -> бул
{
    изм найдено = нет
    поСтрокам: цикл строка в строки
    {
        цикл число в строка
        {
            если число < 0
            {
                найдено = да
                прервать поСтрокам
            }
        }
    }
    возврат найдено
}
