откр функ разобратьЦ64(запись: стр) -> ?ц64
{
    байты = запись.байты()
    отрицательное = байты.длина > 0 и байты[0] == б'-'
    начало: разм = выбор отрицательное
    {
        да  => 1
        нет => 0
    }
    если начало == байты.длина
    {
        возврат Ничего
    }
    изм значение: ?ц64 = Есть(0)
    цикл байт в байты[начало..]
    {
        если байт не в б'0'..=б'9'
        {
            возврат Ничего
        }
        цифра = (байт - б'0') как ц64
        значение = выбор отрицательное
        {
            да  => значение *? 10 -? цифра
            нет => значение *? 10 +? цифра
        }
    }
    возврат значение
}

