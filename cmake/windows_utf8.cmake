function(splav_add_executable name)
    add_executable(${name} ${ARGN})
    target_link_libraries(${name} PRIVATE splav_flags)
    if(WIN32)
        if(MSVC OR CMAKE_CXX_SIMULATE_ID STREQUAL "MSVC")
            target_sources(${name} PRIVATE "${PROJECT_SOURCE_DIR}/cmake/utf8.manifest")
        else()
            message(WARNING "${name}: манифест activeCodePage=UTF-8 встраивается только компоновщиками MSVC и lld-link")
        endif()
    endif()
endfunction()
