add_library(splav_flags INTERFACE)

if(MSVC)
    target_compile_options(splav_flags INTERFACE /utf-8 /W4 /permissive-)
    target_compile_definitions(splav_flags INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS)
    if(SPLAV_WERROR)
        target_compile_options(splav_flags INTERFACE /WX)
    endif()
else()
    target_compile_options(splav_flags INTERFACE -Wall -Wextra -Wpedantic -Wshadow -Wconversion)
    if(WIN32)
        target_compile_definitions(splav_flags INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN)
    endif()
    if(SPLAV_WERROR)
        target_compile_options(splav_flags INTERFACE -Werror)
    endif()
endif()

if(SPLAV_SANITIZE OR SPLAV_FUZZ)
    if(MSVC)
        message(FATAL_ERROR "SPLAV_SANITIZE и SPLAV_FUZZ рассчитаны на Clang и GCC")
    endif()
    set(SPLAV_SANITIZER_FLAGS -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
    target_compile_options(splav_flags INTERFACE ${SPLAV_SANITIZER_FLAGS})
    target_link_options(splav_flags INTERFACE ${SPLAV_SANITIZER_FLAGS})
endif()

if(SPLAV_FUZZ)
    if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
        message(FATAL_ERROR "SPLAV_FUZZ требует Clang: libFuzzer входит в его поставку")
    endif()
    target_compile_options(splav_flags INTERFACE -fsanitize=fuzzer-no-link)
endif()
