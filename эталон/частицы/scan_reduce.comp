#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer Source { uint source[]; };
layout(std430, binding = 1) writeonly buffer Totals { uint totals[]; };

layout(push_constant) uniform Extent
{
    uint count;
} extent;

const uint THREADS = 256u;
const uint PER_THREAD = 4u;
const uint BLOCK = THREADS * PER_THREAD;

shared uint partial[THREADS];

void main()
{
    uint local = gl_LocalInvocationID.x;
    uint blockBase = gl_WorkGroupID.x * BLOCK;
    uint sum = 0u;
    for (uint item = 0u; item < PER_THREAD; ++item)
    {
        uint index = blockBase + local + item * THREADS;
        if (index < extent.count)
        {
            sum += source[index];
        }
    }
    partial[local] = sum;
    barrier();
    for (uint width = THREADS / 2u; width > 0u; width >>= 1u)
    {
        if (local < width)
        {
            partial[local] += partial[local + width];
        }
        barrier();
    }
    if (local == 0u)
    {
        totals[gl_WorkGroupID.x] = partial[0];
    }
}
